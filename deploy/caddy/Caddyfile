{
	email {$ACME_EMAIL}
	admin off
}

# Public API. Route prefix /api comes from API/host.json.
{$API_DOMAIN} {
	encode zstd gzip

	# Never expose the Functions host administration API through the proxy.
	@functionsAdmin path /admin /admin/*
	respond @functionsAdmin 404

	reverse_proxy api:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Backend HTTP functions: Strava webhook, token refresh, admin/backfill routes.
{$BACKEND_DOMAIN} {
	encode zstd gzip

	@functionsAdmin path /admin /admin/*
	respond @functionsAdmin 404

	reverse_proxy backend-api:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Grafana login is handled by Grafana itself.
{$GRAFANA_DOMAIN} {
	encode zstd gzip
	reverse_proxy grafana:3000
}
