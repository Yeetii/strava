# ---------------------------------------------------------------------------
# Copy to deploy/.env (never commit it) and fill in the values.
# On the server the file lives at /opt/stacks/strava/.env.

# ---------------------------------------------------------------------------
# Images / deployment
# ---------------------------------------------------------------------------
REGISTRY=ghcr.io
# GitHub user or organisation that owns the GHCR packages, lowercase.
IMAGE_NAMESPACE=your-github-user
# Filled by the deploy workflow; can also be a commit SHA for a manual rollback.
IMAGE_TAG=latest
# Empty for the safe parallel phase. Enable later:
#   workers            -> Service Bus + Cosmos change-feed workers
#   schedules          -> timer-triggered discovery jobs
#   workers,schedules  -> both
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Azure resources that are NOT being migrated yet
# ---------------------------------------------------------------------------
AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=REPLACE;AccountKey=REPLACE;EndpointSuffix=core.windows.net
BlobStorageConnection=DefaultEndpointsProtocol=https;AccountName=REPLACE;AccountKey=REPLACE;EndpointSuffix=core.windows.net
CosmosDBConnection=AccountEndpoint=https://REPLACE.documents.azure.com:443/;AccountKey=REPLACE;
# Gateway is more tolerant of container networking; switch to Direct if desired.
CosmosConnectionMode=Gateway
# Optional. Live RU checks need Azure credentials on the host. Leave empty to
# skip them; admin status still works, it just won't show live RU/s.
CosmosAccountResourceId=
ServiceBusConnection=Endpoint=sb://REPLACE.servicebus.windows.net/;SharedAccessKeyName=REPLACE;SharedAccessKey=REPLACE
AzureSignalRConnectionString=Endpoint=https://REPLACE.service.signalr.net;AccessKey=REPLACE;Version=1.0;

# ---------------------------------------------------------------------------
# Application secrets / settings
# ---------------------------------------------------------------------------
StravaClientSecret=REPLACE
stravaVerifyToken=REPLACE
AdminApiKey=REPLACE
AllowedOrigins=https://peakshunters.erikmagnusson.com
MistralStudioApiUrl=https://api.mistral.ai/v1/conversations
MistralStudioAgentId=REPLACE
MistralStudioApiKey=REPLACE
APPLICATIONINSIGHTS_CONNECTION_STRING=
OverpassMaxConcurrency=4

# Optional Garmin proxy settings. Leave commented out unless configured; an
# empty GarminProxyBaseUrl is not a valid URI.
# GarminProxyBaseUrl=https://garmin-proxy.example.com/api/
# LIFEDASH_FUNCTIONS_KEY=

# ---------------------------------------------------------------------------
# Redis (available for the upcoming cache work; not used by code yet)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------------------
# Resource limits (tune to the server)
# ---------------------------------------------------------------------------
API_MEMORY_LIMIT=1g
API_CPUS=1.0
BACKEND_API_MEMORY_LIMIT=1g
BACKEND_API_CPUS=1.0
WORKER_SCHEDULE_MEMORY_LIMIT=1g
WORKER_SCHEDULE_CPUS=1.0
WORKER_HEAVY_MEMORY_LIMIT=2g
WORKER_HEAVY_CPUS=2.0

# Optional overrides
FUNCTIONS_LOG_LEVEL=Warning
APPINSIGHTS_SAMPLING_ENABLED=true
