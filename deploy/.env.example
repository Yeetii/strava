# ---------------------------------------------------------------------------
# Copy to deploy/.env (never commit it) and fill in the values.
# On the server the file lives at /opt/stacks/strava/.env.

# ---------------------------------------------------------------------------
# Images / deployment
# ---------------------------------------------------------------------------
REGISTRY=ghcr.io
# GitHub user or organisation that owns the GHCR packages, lowercase.
IMAGE_NAMESPACE=your-github-user
# Filled by the deploy workflow; can also be a commit SHA for a manual rollback.
IMAGE_TAG=latest
# Worker roles are off by default so the API can be validated on its own.
#   workers            -> queue consumers + PostgreSQL polling jobs
#   schedules          -> Hangfire recurring jobs (the 12 weekly crons)
#   workers,schedules  -> both
COMPOSE_PROFILES=

# Durable Hangfire storage (AOF + noeviction is configured in docker-compose.yml).
REDIS_CONNECTION_STRING=redis:6379,abortConnect=false

# ---------------------------------------------------------------------------
# PostgreSQL (domain data; the in-stack image includes PostGIS)
# ---------------------------------------------------------------------------
POSTGRES_DB=strava
POSTGRES_USER=strava
POSTGRES_PASSWORD=strava
POSTGRES_DATA_DIR=/opt/data/strava/postgres

# ---------------------------------------------------------------------------
# Application secrets / settings
# ---------------------------------------------------------------------------
StravaClientSecret=REPLACE
stravaVerifyToken=REPLACE
AdminApiKey=REPLACE
AllowedOrigins=https://peakshunters.erikmagnusson.com,https://stigar.erikmagnusson.com
MistralStudioApiUrl=https://api.mistral.ai/v1/conversations
MistralStudioAgentId=REPLACE
MistralStudioApiKey=REPLACE
OverpassMaxConcurrency=4

# Optional Garmin proxy settings. Leave commented out unless configured; an
# empty GarminProxyBaseUrl is not a valid URI.
# GarminProxyBaseUrl=https://garmin-proxy.example.com/api/
# LIFEDASH_FUNCTIONS_KEY=

# ---------------------------------------------------------------------------
# Resource limits (tune to the server)
# ---------------------------------------------------------------------------
API_MEMORY_LIMIT=1g
API_CPUS=1.0
WORKER_SCHEDULE_MEMORY_LIMIT=1g
WORKER_SCHEDULE_CPUS=1.0
WORKER_HEAVY_MEMORY_LIMIT=2g
WORKER_HEAVY_CPUS=2.0
PMTILES_MEMORY_LIMIT=2g
PMTILES_CPUS=2.0

# Host directory holding organizer JSON, route GPX, transparency and PMTiles.
# Mounted read-write into every self-hosted service at /data/races.
RACE_DATA_DIR=/opt/data/strava/races

# Host directory holding highway shards ({z}/{x}/{y}.pbf) and zoom indexes
# (index/{z}/{x}/{y}.json). Mounted at /data/shards in api and both workers,
# as a sibling of RACE_DATA_DIR under /opt/data/strava.
SHARD_DATA_DIR=/opt/data/strava/shards

# Every self-hosted service (api, worker-schedule, worker-heavy and pmtiles)
# uses the local organizer store on that shared directory: compose forces
# OrganizerStore__Provider=FileSystem and OrganizerStore__RaceDataDir=/data/races
# for all of them, so do not set them here. Compose also forces
# ShardStore__Provider=FileSystem and ShardStore__RootDir=/data/shards on the API
# and workers. Compose also forces RaceTiles__OutputPath, RaceTiles__WeeklyCron
# and WriteTransparency for pmtiles.

# Optional: General log level for the plain hosts
Logging__LogLevel__Default=Warning
