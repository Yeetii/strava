<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="a2n.Hangfire.Dashboard" Version="2.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stigar.Workers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stigar.Core\Stigar.Core.csproj" />
  </ItemGroup>

  <!-- StoreCuratedPeaksGroups reads ./peaks.json at runtime. -->
  <ItemGroup>
    <None Update="peaks.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="openapi/openapi.source.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
